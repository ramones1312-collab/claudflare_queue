#!/bin/sh
# KAWA Edge deployer launcher (Synology NAS / any Docker host).
#   sudo ./kawa-edge <command> [args]        e.g.  sudo ./kawa-edge install
# Builds the image on first use (then cached: seconds when nothing changed) and runs one command
# in a throw-away container. Nothing keeps running afterwards.
set -eu
# R3-15 · run only as the real file inside the package: through a link, dirname($0) would be the link's
# folder, not the package.
[ ! -L "$0" ] || { echo "ERROR: run ./kawa-edge from the package folder itself, not through a symbolic link" >&2; exit 1; }
cd "$(dirname "$0")"

die() { echo "ERROR: $*" >&2; exit 1; }

if [ "${1:-}" = "verify-zip" ]; then
  # Read-only integrity check of the delivered ZIP, before anything else:
  #   ./kawa-edge verify-zip <zip> [expected-sha256]      (uses <zip>.sha256 when no hash is given)
  zip="${2:?usage: ./kawa-edge verify-zip <path/to/KAWA_...zip> [expected-sha256]}"
  # The sidecar's FIRST line is the ZIP hash; the second one is the manifest hash (checked inside).
  want="${3:-$(head -n 1 "$zip.sha256" 2>/dev/null | cut -d' ' -f1 || true)}"
  [ -n "$want" ] || { echo "FAIL  no $zip.sha256 and no expected hash given" >&2; exit 1; }
  got=$(sha256sum "$zip" | cut -d' ' -f1)
  echo "sha256 $got"
  [ "$want" = "$got" ] && { echo "PASS  matches the expected SHA-256"; exit 0; }
  echo "FAIL  expected $want" >&2; exit 1
fi


# Run as the owner of this folder (not root), so state/ is yours and the container needs no privilege.
KAWA_UID=$(stat -c %u .); KAWA_GID=$(stat -c %g .)
export KAWA_UID KAWA_GID
[ "$KAWA_UID" != "0" ] || die "this folder belongs to root. Give it to your NAS user first (e.g. chown -R <user>:users .); the deployer container must never run as root."

# This script usually runs under sudo. It must NEVER follow a symbolic link while privileged: a link
# planted in state/, secrets/ or config/ (by anyone, or by code in the container, which mounts them)
# could otherwise make root change or overwrite a file outside this package.
for p in state secrets config; do [ ! -L "$p" ] || die "$p is a symbolic link; refusing to run"; done
# R3-15 · docker compose (under sudo) reads .env: it must be a regular file of the folder owner, or absent.
if [ -e .env ] || [ -L .env ]; then
  [ ! -L .env ] && [ -f .env ] && [ "$(stat -c %u .env)" = "$KAWA_UID" ] || die ".env must be a regular file owned by the folder owner (uid $KAWA_UID)"
fi
mkdir -p state secrets config
link=$(find state secrets config -type l -print 2>/dev/null | head -n 1)
[ -z "$link" ] || die "symbolic link found at $link; remove it (nothing was changed)"
# Created by sudo => root-owned; hand them to the folder owner the container runs as. Only what root owns,
# never through a link (-h), and never a file with a second hard link (it could be a file outside this
# package, e.g. on the same /volume1).
find state secrets config -user 0 \( -type d -o \( -type f -links 1 \) \) -exec chown -h "$KAWA_UID:$KAWA_GID" {} + 2>/dev/null || true
find state secrets -maxdepth 0 -type d -exec chmod 700 {} + 2>/dev/null || true

if docker compose version >/dev/null 2>&1; then DC="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then DC="docker-compose"
else echo "ERROR: docker compose not found. Install 'Container Manager' from the DSM Package Center." >&2; exit 1; fi


# The release ZIP is deterministic: every file carries the same fixed timestamp. Unzipped over an
# older release, a changed file of equal size looks unchanged to BuildKit's incremental context sync
# (size + mtime), and the image would keep the old bytes (the manifest check then refuses to run).
# So whenever the package manifest differs from the one the image was built from, refresh mtimes.
# The manifest the image was built from is read from the image itself: root writes no stamp file.
IMAGE=kawa-edge-deployer:1.3.1-nas-r3.2
refresh_context() {
  cur=$(sha256sum MANIFEST_SHA256_V1_3_1.json 2>/dev/null | cut -d' ' -f1)
  img=$(docker run --rm --network none --entrypoint sha256sum "$IMAGE" /opt/kawa/MANIFEST_SHA256_V1_3_1.json 2>/dev/null | cut -d' ' -f1)
  if [ "$cur" != "$img" ]; then
    # Regular files only (never a link), outside the folders the container can write.
    th=""; touch -h -c . 2>/dev/null && th="-h"     # never follow a link swapped in after find (where supported)
    find . \( -path ./state -o -path ./secrets -o -path ./config \) -prune -o -type f -exec touch -c $th {} +
    FORCE_BUILD=1
  fi
}
FORCE_BUILD=0
refresh_context
if [ "${1:-}" = "refresh-context" ]; then echo "context refreshed (rebuild needed: $FORCE_BUILD)"; exit 0; fi

# KAWA_SKIP_BUILD=1: use an image you built yourself (e.g. behind a TLS-inspecting proxy, see README).
if [ "${KAWA_SKIP_BUILD:-}" != "1" ]; then
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "Building the deployer image (first run only; a few minutes on a NAS)…"
  fi
  if [ -n "${HTTPS_PROXY:-}" ]; then $DC build --quiet --build-arg HTTPS_PROXY="$HTTPS_PROXY" installer >/dev/null
  else $DC build --quiet installer >/dev/null; fi
fi
exec $DC run --rm installer "$@"
